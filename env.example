DATABASE_URL=postgresql://postgres:menschis@localhost:5432/menschis

# OIDC / next-auth
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_GROUP=admin

NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# SMTP (transactional email)
# If SMTP_HOST or SMTP_FROM is missing, emails are skipped with a warning.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Menschis <noreply@example.com>"

# Ticketing (Pretix.eu Optional)
PRETIX_ORG=
PRETIX_API_TOKEN=

# Captcha (Turnstile Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

BANNER_PILL_TEXT=
BANNER_PILL_COLOR=